@model IEnumerable<CrystalCarCare.Models.Car>

@{
    ViewBag.Title = "Car Rental - Crystal Car Care";
    string currentSort = ViewBag.CurrentSort ?? "AlphaAsc";
    string searchString = ViewBag.SearchString ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #111;
            color: #FFD700;
        }

        a {
            color: #FFD700;
            text-decoration: none;
        }

            a:hover {
                color: #FFA500;
            }

        .card {
            background-color: #1a1a1a;
            border: 1px solid #444;
            border-radius: 12px;
            color: #FFD700;
            transition: transform 0.3s;
        }

            .card:hover {
                transform: translateY(-8px);
                box-shadow: 0 15px 30px rgba(255, 215, 0, 0.3);
            }

        .card-img-top {
            height: 200px;
            object-fit: cover;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
        }

        .btn-primary {
            background-color: #FFD700;
            border-color: #FFD700;
            color: #111;
            font-weight: 600;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
        }

            .btn-primary:hover {
                background-color: #FFA500;
                border-color: #FFA500;
            }

            .btn-primary.active {
                box-shadow: 0 0 8px #FFD700 inset;
            }

        .btn-secondary {
            background-color: #1a1a1a;
            border-color: #444;
            color: #FFD700;
            font-weight: 600;
        }

        .form-control {
            border-radius: 8px;
            border: 1px solid #444;
            background: #111;
            color: #FFD700;
        }

            .form-control:focus {
                border-color: #FFD700;
                box-shadow: 0 0 10px rgba(255,215,0,0.3);
                outline: none;
                background: #111;
                color: #fff;
            }

        .text-success {
            color: #32CD32 !important;
        }

        .text-danger {
            color: #FF4500 !important;
        }

        h1 {
            margin-bottom: 2rem;
            color: #FFD700;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <h1 class="text-center">Car Rental Options</h1>

        <!-- Search Form -->
        <form action="@Url.Action("Index","CarRent")" method="get" class="d-flex mb-3 flex-wrap gap-2">
            <input type="hidden" name="sortOrder" value="@currentSort" />
            <input type="text" name="searchString" class="form-control me-2" placeholder="Search by Make or Model" value="@searchString" />
            <button type="submit" class="btn btn-primary">Search</button>
        </form>

        <!-- Sort Buttons -->
        <div class="mb-4 d-flex flex-wrap gap-2">
            <a href="@Url.Action("Index", new { sortOrder="PriceAsc", searchString=searchString })" class="btn btn-primary @(currentSort=="PriceAsc"?"active":"")">Price ↑</a>
            <a href="@Url.Action("Index", new { sortOrder="PriceDesc", searchString=searchString })" class="btn btn-primary @(currentSort=="PriceDesc"?"active":"")">Price ↓</a>
            <a href="@Url.Action("Index", new { sortOrder="AlphaAsc", searchString=searchString })" class="btn btn-primary @(currentSort=="AlphaAsc"?"active":"")">A → Z</a>
            <a href="@Url.Action("Index", new { sortOrder="AlphaDesc", searchString=searchString })" class="btn btn-primary @(currentSort=="AlphaDesc"?"active":"")">Z → A</a>
            <a href="@Url.Action("Index", new { sortOrder="YearAsc", searchString=searchString })" class="btn btn-primary @(currentSort=="YearAsc"?"active":"")">Year ↑</a>
            <a href="@Url.Action("Index", new { sortOrder="YearDesc", searchString=searchString })" class="btn btn-primary @(currentSort=="YearDesc"?"active":"")">Year ↓</a>
        </div>

        <!-- Car List -->
        <div class="row">
            @foreach (var car in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <img src="@Url.Content(car.ImageUrl ?? "~/Content/img/default-avatar.jpg")" class="card-img-top" alt="@car.Make @car.Model">
                        <div class="card-body">
                            <h5 class="card-title">@car.Make @car.Model (@car.Year)</h5>
                            <p class="card-text">Price per day: <strong>$@car.RentalPricePerDay</strong></p>
                            <p class="card-text">Available: <span class="@(car.IsAvailable?"text-success":"text-danger")">@((car.IsAvailable?"Yes":"No"))</span></p>
                            @if (car.IsAvailable)
                            {
                                <a href="@Url.Action("Rent","CarRent", new { id=car.Id })" class="btn btn-primary w-100">Rent Now</a>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100" disabled>Rent Now</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</body>
</html>

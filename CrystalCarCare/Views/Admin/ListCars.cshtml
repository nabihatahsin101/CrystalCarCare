@model IEnumerable<CrystalCarCare.Models.Car>
@{
    ViewBag.Title = "Manage Cars";
}

<h2>Manage Cars</h2>
<p>@Html.ActionLink("Add New Car", "AddCar", "Admin", null, new { @class = "btn btn-success mb-3" })</p>

<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Image</th>
            <th>Make</th>
            <th>Model</th>
            <th>Year</th>
            <th>Price/Day</th>
            <th>Available</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var car in Model)
        {
            <tr>
                <td><img src="@Url.Content(car.ImageUrl ?? "~/Content/img/default-avatar.jpg")" width="100" /></td>
                <td>@car.Make</td>
                <td>@car.Model</td>
                <td>@car.Year</td>
                <td>$@car.RentalPricePerDay</td>
                <td>@(car.IsAvailable ? "Yes" : "No")</td>
                <td>
                    @Html.ActionLink("Edit", "EditCar", new { id = car.Id }, new { @class = "btn btn-primary btn-sm" })
                    @Html.ActionLink("Delete", "DeleteCar", new { id = car.Id }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>

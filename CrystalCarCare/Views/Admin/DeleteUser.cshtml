@model CrystalCarCare.Models.UserRegister
@{
    ViewBag.Title = "Delete User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="glass-card p-4 shadow-lg">
        <div class="mb-4">
            <h2 class="text-danger">Confirm Delete</h2>
            <p class="text-warning">Are you sure you want to delete this user?</p>
        </div>

        <table class="table table-bordered table-hover glass-card p-2">
            <tr><th>User Id</th><td>@Model.UserId</td></tr>
            <tr><th>User Name</th><td>@Model.UserName</td></tr>
            <tr><th>Email</th><td>@Model.Email</td></tr>
        </table>

        @using (Html.BeginForm("DeleteUser", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.UserId)

            <div class="d-flex justify-content-between mt-4">
                <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
                @Html.ActionLink("Cancel", "Users", null, new { @class = "btn btn-secondary px-4" })
            </div>
        }
    </div>
</div>

@model CrystalCarCare.Models.Car
@{
    ViewBag.Title = "Delete Car";
}

<h2>Delete Car</h2>

<p>Are you sure you want to delete this car?</p>

<div>
    <strong>@Model.Make @Model.Model (@Model.Year)</strong>
</div>
<div>
    Price per day: $@Model.RentalPricePerDay
</div>

@using (Html.BeginForm("DeleteCarConfirmed", "Admin", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <button type="submit" class="btn btn-danger">Delete</button>
    @Html.ActionLink("Cancel", "ListCars", null, new { @class = "btn btn-secondary" })
}

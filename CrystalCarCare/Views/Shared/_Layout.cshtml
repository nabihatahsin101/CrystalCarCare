<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Crystal Car Care</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

    <style>

        /* -------------------- Global -------------------- */
        body {
            font-family: 'Roboto', sans-serif;
            background: #111; /* Full dark background */
            color: #e0e0e0;
            scroll-behavior: smooth;
        }

        a {
            text-decoration: none;
            transition: 0.3s;
        }

            a:hover {
                color: #FFD700;
            }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1rem;
        }

        /* -------------------- Navbar -------------------- */
        .navbar {
            background: #111;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.8rem;
            color: #FFD700 !important;
            letter-spacing: 1px;
            transition: 0.3s;
        }

            .navbar-brand:hover {
                color: #FFA500 !important;
                transform: scale(1.05);
            }

        .nav-link {
            color: #e0e0e0 !important;
            font-weight: 500;
            position: relative;
            transition: all 0.3s;
        }

            .nav-link::after {
                content: '';
                position: absolute;
                width: 0;
                height: 2px;
                background: #FFD700;
                bottom: -5px;
                left: 0;
                transition: width 0.3s;
            }

            .nav-link:hover {
                color: #FFD700 !important;
            }

                .nav-link:hover::after {
                    width: 100%;
                }

        .btn-cta {
            background: #FFD700;
            color: #111 !important;
            font-weight: 600;
            border-radius: 8px;
            padding: 0.7rem 1.5rem;
            margin-left: 1rem;
            box-shadow: 0 6px 15px rgba(255, 215, 0,0.2);
            transition: 0.3s all;
        }

            .btn-cta:hover {
                background: #FFA500;
                color: #111 !important;
                transform: scale(1.05);
                box-shadow: 0 10px 25px rgba(255, 215, 0,0.4);
            }

        /* -------------------- Hero Section -------------------- */
        .hero {
            background: linear-gradient(135deg, #111, #1a1a1a);
            background-image: url('https://images.unsplash.com/photo-1581091012184-3c0b71d607f7?auto=format&fit=crop&w=1950&q=80');
            background-size: cover;
            background-position: center;
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            color: #FFD700;
        }

            .hero::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.6); /* dark overlay */
            }

        .hero-content {
            position: relative;
            text-align: center;
            max-width: 700px;
            z-index: 2;
        }

            .hero-content h1 {
                font-size: 3rem;
                font-weight: 700;
                margin-bottom: 1rem;
            }

            .hero-content p {
                font-size: 1.2rem;
                margin-bottom: 2rem;
                color: #fff;
            }

            .hero-content .btn-cta {
                font-size: 1.1rem;
                padding: 0.8rem 2rem;
            }

        /* -------------------- Cards -------------------- */
        .card-glass {
            background: rgba(0,0,0,0.6); /* fully dark card */
            backdrop-filter: blur(5px);
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            padding: 2rem;
            color: #FFD700;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card-glass:hover {
                transform: translateY(-8px);
                box-shadow: 0 20px 40px rgba(255, 215, 0, 0.3);
            }

        /* -------------------- Forms -------------------- */
        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #444;
            background: #111;
            color: #FFD700;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #FFD700;
                box-shadow: 0 0 10px rgba(255, 215, 0,0.3);
                outline: none;
                background: #111;
            }

        /* -------------------- Footer -------------------- */
        footer {
            background: linear-gradient(135deg, #111, #1a1a1a);
            color: #fff;
            padding: 3rem 0;
            border-top: 5px solid #FFD700;
        }

            footer h5 {
                font-size: 1.2rem;
                margin-bottom: 1rem;
                color: #FFD700;
            }

            footer ul li a {
                color: #e0e0e0;
                font-size: 0.95rem;
                transition: 0.3s;
            }

                footer ul li a:hover {
                    color: #FFD700;
                }

        .footer-social a {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 38px;
            height: 38px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
            margin-right: 0.5rem;
            transition: all 0.3s;
        }

            .footer-social a:hover {
                background: #FFD700;
                color: #111;
                transform: scale(1.2);
            }

        /* -------------------- Responsive -------------------- */
        @@media (max-width:768px) {
            .navbar-nav {
                text-align: center;
            }

            .btn-cta {
                margin: 0.5rem 0 0 0;
            }

            .hero-content h1 {
                font-size: 2rem;
            }

            .hero-content p {
                font-size: 1rem;
            }
        }

#aiChatbox {
    display: none;
    position: fixed;
    bottom: 80px; /* space above floating button */
    right: 20px;
    width: 360px;
    font-family: Arial, sans-serif;
    z-index: 9999;
    cursor: grab;
}

#aiChatHeader {
    background: #007bff;
    color: #fff;
    padding: 14px 16px;
    font-weight: bold;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 12px 12px 0 0;
    user-select: none;
}

#aiCloseBtn {
    font-size: 20px;
    cursor: pointer;
}

#aiChatBody {
    display: none;
    flex-direction: column;
    background: #f8f9fa;
    max-height: 480px;
    border-radius: 0 0 12px 12px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    overflow: hidden;
    transition: all 0.3s ease;
}

#aiChatBody.open {
    display: flex;
}

#aiMessages {
    flex: 1;
    padding: 12px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.message {
    max-width: 75%;
    padding: 10px 15px;
    border-radius: 18px;
    word-wrap: break-word;
    opacity: 0;
    animation: fadeIn 0.3s forwards;
}

.message.user {
    background: #007bff;
    color: #fff;
    align-self: flex-end;
    border-bottom-right-radius: 4px;
}

.message.ai {
    background: #e5e5ea;
    color: #000;
    align-self: flex-start;
    border-bottom-left-radius: 4px;
}

.message.typing::after {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-left: 4px;
    border-radius: 50%;
    background: #555;
    animation: blink 1s infinite alternate;
}

@@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

@@keyframes blink {
    0%, 100% { transform: scale(0.5); opacity: 0.3; }
    50% { transform: scale(1); opacity: 1; }
}

#aiInputArea {
    display: flex;
    border-top: 1px solid #ddd;
    background: #fff;
}

#aiInputArea input {
    flex: 1;
    padding: 12px;
    border: none;
    outline: none;
    font-size: 14px;
    border-radius: 0 0 0 12px;
}

#aiInputArea button {
    background: #007bff;
    color: #fff;
    border: none;
    padding: 0 20px;
    cursor: pointer;
    border-radius: 0 0 12px 0;
    transition: background 0.3s;
}

#aiInputArea button:hover {
    background: #0056b3;
}

#aiFloatingBtn {
    position: fixed;
    bottom: 20px;
    right: 30px;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: none;
    background: #007bff;
    color: #fff;
    font-size: 24px;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    z-index: 10000;
    transition: background 0.3s;
}

#aiFloatingBtn:hover {
    background: #0056b3;
}


    </style>


    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>

<body>
